<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:Lab2.Models"
        xmlns:views="using:Lab2.Views"
        x:Class="Lab2.Views.MainWindow"
        x:DataType="views:MainWindow"
        Title="Space Ship Manager" Width="760" Height="620">

    <Grid ColumnDefinitions="300,*" RowDefinitions="*">
        <StackPanel Grid.Column="0" Margin="10" Spacing="10">
            <TextBlock Text="Тип нового корабля:" FontWeight="Bold"/>
            <ComboBox x:Name="TypeSelector" HorizontalAlignment="Stretch"/>

            <Button Content="Создать корабль" Click="CreateShip_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="LightGreen"/>

            <Separator Height="8"/>

            <TextBlock Text="Модули расширения:" FontWeight="Bold"/>
            <TextBlock x:Name="ModulesStatusText"
                       TextWrapping="Wrap"
                       FontSize="11"
                       Foreground="Gray"/>
            <Button Content="Обновить модули из папки Plugins"
                    Click="ReloadModules_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

            <Separator Height="8"/>

            <TextBlock Text="Список флота:" FontWeight="Bold"/>
            <ListBox x:Name="ShipsList" MinHeight="180" MaxHeight="240" SelectionChanged="ShipsList_SelectionChanged"/>

            <Button Content="Удалить выбранный"
                    Click="RemoveShip_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsEnabled="{Binding #ShipsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>

            <Separator Height="8"/>

            <TextBlock Text="Формат файла:" FontWeight="Bold"/>
            <ComboBox x:Name="SerializerTypeComboBox" HorizontalAlignment="Stretch" SelectedIndex="0">
                <ComboBoxItem Content="TXT (свой формат)"/>
                <ComboBoxItem Content="JSON (Newtonsoft.Json)"/>
                <ComboBoxItem Content="Бинарный (MessagePack)"/>
            </ComboBox>

            <Button Content="Сохранить флот в файл…" Click="SaveFleet_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>

            <Button Content="Загрузить флот из файла…" Click="LoadFleet_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="10" Spacing="10">
            <TextBlock Text="Инспектор объекта:" FontWeight="Bold"/>
            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
                <ScrollViewer Height="320">
                    <StackPanel x:Name="InspectorPanel" Spacing="10"/>
                </ScrollViewer>
            </Border>

            <TextBlock Text="Действия модуля:" FontWeight="Bold"/>
            <StackPanel x:Name="ModuleActionsPanel" Spacing="6"/>

            <Button Content="Выполнить миссию"
                    Click="Execute_Click"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    IsEnabled="{Binding #ShipsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}"/>
        </StackPanel>
    </Grid>

</Window>
